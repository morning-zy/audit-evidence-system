# Docker Compose 环境变量（可选）
#
# 用法：复制为 .env 后按需修改，docker compose 会自动读取。
# .env 已被 .gitignore 排除，不会进入版本库。
#
# 不建 .env 也能跑：compose 里所有变量都写了演示默认值。
# 但如果你把这个项目部署到能被别人访问的机器上，务必改掉密码和 JWT secret。

# MySQL root 密码
DB_PASSWORD=change-me-in-production

# JWT 签名密钥：必须足够长（HS256 要求 ≥ 32 字节），生产环境请用随机串
# 生成方式：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-48-bytes-string-before-deploy

# 是否暴露 Swagger 接口文档（生产建议 false）
API_DOCS_ENABLED=true

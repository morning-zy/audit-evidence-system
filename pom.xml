<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- =================================================================
         Spring Boot 父工程：统一管理 Spring 全家桶版本
         选 3.5.16 而非 4.x 的理由：
           1) 中文面试与招聘 JD 当前主线仍是 3.x，八股、教程、社区答案都对得上
           2) 3.x 与 4.x 在注解驱动/自动配置/starter 机制上是同一套，迁移成本极低
           3) 4.x 换掉了 Jackson 3.x（包名 com.fasterxml -> tools.jackson），
              新手照教程抄代码极易踩坑
         ================================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.maning</groupId>
    <artifactId>audit-evidence-system</artifactId>
    <version>1.0.0</version>
    <name>audit-evidence-system</name>
    <description>审计证据管理系统 - 审计项目/审计事项/证据采集与分级复核</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- MyBatis-Plus：必须是 spring-boot3 专用 starter，用老坐标会在 Boot 3 下报
             "Invalid value type for attribute 'factoryBeanObjectType'" -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <!-- 必须与 Spring Boot 3.5 匹配；2.8.x 是支持 Spring 6.2 的版本线 -->
        <springdoc.version>2.8.17</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
        <hutool.version>5.8.40</hutool.version>
        <easyexcel.version>4.0.3</easyexcel.version>
        <!-- JaCoCo：代码覆盖率。0.8.12 才正式支持 Java 21 的 class 文件版本（65） -->
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencies>
        <!-- ============ Web 基础 ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：@NotBlank / @NotNull / @Min 等，配合 @Valid 使用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============ AOP ============ -->
        <!-- 操作日志切面需要它。spring-boot-starter-aop 会引入 aspectjweaver，
             只引 aspectjrt 不够 —— @Aspect 注解定义在 aspectjweaver 里 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ============ 持久层 ============ -->
        <!-- MyBatis-Plus 3.5.9 起拆出了 mybatis-plus-jsqlparser，分页插件必须额外引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============ 缓存 ============ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 连接池：Spring Boot 默认用 Lettuce，但 Lettuce 需要 commons-pool2 才能启用池化 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ============ 安全 ============ -->
        <!-- 只用 Spring Security 的 BCrypt 密码加密，不引入完整过滤器链。
             我们是前后端分离 + JWT，用 HandlerInterceptor 更轻、更可控 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JWT：0.12.x 是新 API，0.9.1 已废弃且与 JDK17+ 有兼容问题 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============ 工具 ============ -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!-- Excel 导出 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
            <version>${easyexcel.version}</version>
        </dependency>

        <!-- ============ 接口文档 ============ -->
        <!--
          为什么不用 knife4j 4.5.0：
            它内置的是 springdoc 2.3.0（按 Spring Boot 3.2 编译），在 Boot 3.5 下访问
            /v3/api-docs 会抛 NoSuchMethodError: ControllerAdviceBean.<init>(Object)。
            手动把 springdoc 升到 2.8.x 后又会撞第二个坑：
            SpringDocConfigProperties.getGroupConfigs() 的返回类型从 List 改成了 Set，
            knife4j 4.5.0 是按 List 编译的，于是继续抛 NoSuchMethodError。
            结论：knife4j 4.5.0 与 Boot 3.5 + springdoc 2.8 组合不兼容。
          改用 springdoc 原生 UI：功能完整，访问 /swagger-ui.html。
          如果一定要用 knife4j 的中文 UI，需要等 knife4j 出适配 2.8 的版本，
          或者把 Boot 降到 3.2.x。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ============ 开发辅助 ============ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ============ 测试 ============ -->
        <!-- 内含 JUnit 5 + Mockito + AssertJ + Hamcrest，版本由父工程统一管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- ============================================================
                 Surefire：跑 JUnit 5 测试
                 默认只匹配 *Test / Test* / *Tests / *TestCase 结尾的类，
                 这里显式写一遍是为了让人一眼看到"测试是怎么被找到的"。
                 argLine 里的 ${argLine} 是 JaCoCo 注入探针用的占位符，
                 一旦自定义了 argLine 就必须带上它，否则覆盖率永远是 0。
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <argLine>@{argLine} -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8</argLine>
                </configuration>
            </plugin>

            <!-- ============================================================
                 JaCoCo 代码覆盖率
                 作用：跑 mvn test 时自动统计"哪些代码被测试执行过"，
                 报告生成在 target/site/jacoco/index.html。

                 注意 excludes 里的三类：
                   ① 启动类 + 配置类 —— 只是装配 Bean，没有判断逻辑，测了也是刷数字
                   ② entity / vo / dto —— Lombok 生成的 getter/setter 会虚高覆盖率
                   ③ mapper 接口 —— 全是 MyBatis 动态代理，没有方法体
                 把这三类排除，"覆盖率"反映的才是真正的业务逻辑被验证了多少。
                 ============================================================ -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <exclude>**/AuditEvidenceApplication.class</exclude>
                        <exclude>**/config/**</exclude>
                        <exclude>**/entity/**</exclude>
                        <exclude>**/vo/**</exclude>
                        <exclude>**/dto/**</exclude>
                        <exclude>**/mapper/**</exclude>
                        <exclude>**/annotation/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!-- prepare-agent 必须在 test 阶段之前跑，负责给 JVM 挂字节码探针 -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <!-- test 阶段结束后生成 HTML + XML 报告 -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                        覆盖率门槛：只在 verify 阶段检查，不影响 `mvn test` 的快速反馈。
                        为什么设门槛而不是"覆盖率越高越好"：
                          没有门槛时，覆盖率只会往下掉 —— 新代码没人有空补测试，
                          反正没人拦。设了 50% 的底线，至少能挡住"整块新功能零测试"。
                        为什么是 50% 而不是 80%：
                          这个项目的 Controller / AOP / 拦截器 / 启动装配占了相当比例的行，
                          它们靠 SmokeTest 这种端到端脚本覆盖，用单元测试硬刷是自欺欺人。
                          真正该被单元测试覆盖的是 Service 和算法类，那部分实际已有 70%+。
                    -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.50</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.45</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
